+/** Small "Testing" / latency pill shown on a source row. */
+@Composable
+internal fun SourceHealthBadge(
+    isTesting: Boolean,
+    latencyMs: Long?,
+    modifier: Modifier = Modifier,
+) {
+    val tokens = MaterialTheme.nuvio.colors
+    val transition = rememberInfiniteTransition(label = "source_health_pulse")
+    val pulse by transition.animateFloat(
+        initialValue = 0.35f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(durationMillis = 850),
+            repeatMode = RepeatMode.Reverse,
+        ),
+        label = "source_health_pulse_alpha",
+    )
+    val label = when {
+        isTesting -> "Testing"
+        latencyMs != null -> formatSourceLatency(latencyMs)
+        else -> null
+    } ?: return
+
+    val container by animateColorAsState(
+        targetValue = if (isTesting) tokens.surfaceElevated.copy(alpha = 0.9f) else tokens.accent.copy(alpha = 0.14f),
+        animationSpec = tween(durationMillis = 180),
+        label = "source_health_container",
+    )
+    val content = if (isTesting) tokens.textMuted else tokens.accent
+
+    Row(
+        modifier = modifier
+            .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+            .background(container)
+            .border(
+                width = 1.dp,
+                color = if (isTesting) tokens.borderDefault else tokens.borderSelected.copy(alpha = 0.5f),
+                shape = RoundedCornerShape(NuvioTokens.Radius.full),
+            )
+            .padding(horizontal = NuvioTokens.Space.s8, vertical = NuvioTokens.Space.s4),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s5),
+    ) {
+        Box(
+            modifier = Modifier
+                .size(6.dp)
+                .alpha(if (isTesting) pulse else 1f)
+                .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+                .background(content),
+        )
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelSmall.copy(
+                fontSize = 11.sp,
+                fontWeight = FontWeight.SemiBold,
+            ),
+            color = content,
+            maxLines = 1,
+        )
+    }
+}
+
+internal fun formatSourceLatency(latencyMs: Long): String =
+    if (latencyMs < 1_000L) "${latencyMs}ms" else "${(latencyMs / 100L) / 10f}s"
+
+/**
+ * Nuvio-styled "Best available" strip. Lists the fastest, good-quality sources
+ * that survived the health sweep and the active language/quality filters, using
+ * a balanced score (quality weight + measured response time).
+ */
+@Composable
+internal fun StreamBestSourcesSection(
+    sources: List<StreamItem>,
+    health: SourceHealthSnapshot,
+    onStreamSelected: (StreamItem) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    if (sources.isEmpty()) return
+    val tokens = MaterialTheme.nuvio.colors
+    Column(
+        modifier = modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(NuvioTokens.Radius.lg))
+            .background(tokens.surfaceElevated.copy(alpha = 0.6f))
+            .border(
+                width = 1.dp,
+                color = tokens.borderDefault,
+                shape = RoundedCornerShape(NuvioTokens.Radius.lg),
+            )
+            .padding(NuvioTokens.Space.s12),
+        verticalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s8),
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s8),
+        ) {
+            Box(
+                modifier = Modifier
+                    .size(8.dp)
+                    .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+                    .background(tokens.accent),
+            )
+            Column {
+                Text(
+                    text = "Best available",
+                    style = MaterialTheme.typography.titleSmall.copy(
+                        fontSize = 14.sp,
+                        fontWeight = FontWeight.Bold,
+                    ),
+                    color = tokens.textPrimary,
+                )
+                Text(
+                    text = if (health.isRunning) "Fastest passing sources · still testing" else "Balanced quality and fast start",
+                    style = MaterialTheme.typography.labelSmall.copy(fontSize = 11.sp),
+                    color = tokens.textMuted,
+                )
+            }
+        }
+        sources.forEachIndexed { index, stream ->
+            BestSourceRow(
+                rank = index + 1,
+                stream = stream,
+                latencyMs = stream.sourceHealthHost()?.let { health.entryFor(it).latencyMs },
+                onClick = { onStreamSelected(stream) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun BestSourceRow(
+    rank: Int,
+    stream: StreamItem,
+    latencyMs: Long?,
+    onClick: () -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio.colors
+    val quality = StreamQualityFilter.DISPLAY_ORDER.firstOrNull { it in stream.sourceFilterQualities }
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(NuvioTokens.Radius.md))
+            .background(tokens.overlayHover)
+            .clickable(onClick = onClick)
+            .padding(horizontal = NuvioTokens.Space.s10, vertical = NuvioTokens.Space.s8),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s10),
+    ) {
+        Box(
+            modifier = Modifier
+                .size(22.dp)
+                .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+                .background(tokens.accent.copy(alpha = 0.18f)),
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(
+                text = rank.toString(),
+                style = MaterialTheme.typography.labelSmall.copy(
+                    fontSize = 11.sp,
+                    fontWeight = FontWeight.Bold,
+                ),
+                color = tokens.accent,
+            )
+        }
+        Text(
+            text = stream.displayName(),
+            style = MaterialTheme.typography.bodySmall.copy(
+                fontSize = 13.sp,
+                fontWeight = FontWeight.Medium,
+            ),
+            color = tokens.textPrimary,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.weight(1f),
+        )
+        if (quality != null) {
+            Text(
+                text = quality.label,
+                style = MaterialTheme.typography.labelSmall.copy(fontSize = 10.sp, fontWeight = FontWeight.SemiBold),
+                color = tokens.textSecondary,
+                modifier = Modifier
+                    .clip(RoundedCornerShape(NuvioTokens.Radius.sm))
+                    .background(tokens.overlaySelected)
+                    .padding(horizontal = NuvioTokens.Space.s6, vertical = NuvioTokens.Space.s2),
+            )
+        }
+        if (latencyMs != null) {
+            Spacer(modifier = Modifier.width(NuvioTokens.Space.s2))
+            Text(
+                text = formatSourceLatency(latencyMs),
+                style = MaterialTheme.typography.labelSmall.copy(fontSize = 10.sp, fontWeight = FontWeight.SemiBold),
+                color = tokens.success,
+            )
+        }
+    }
+}
