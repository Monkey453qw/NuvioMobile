+fun deriveSourceFilterQualities(item: StreamItem): Set<StreamQualityFilter> {
+    val text = item.sourceFilterText
+    if (text.isBlank()) return emptySet()
+    return StreamQualityFilter.DISPLAY_ORDER.filter { filter ->
+        QUALITY_TOKEN_PATTERNS[filter].orEmpty().any { pattern -> pattern.containsMatchIn(text) }
+    }.toSet()
+}
+
+fun deriveSourceFilterLanguages(item: StreamItem): Set<String> {
+    val text = item.sourceFilterText
+    if (text.isBlank()) return emptySet()
+    return LANGUAGE_TOKEN_PATTERNS.filterValues { patterns ->
+        patterns.any { pattern -> pattern.containsMatchIn(text) }
+    }.keys
+}
+
+/** True when the stream survives the active quality + language selection. */
+fun StreamItem.matchesSourceFilters(
+    qualities: Set<StreamQualityFilter>,
+    languages: Set<String>,
+): Boolean {
+    if (qualities.isEmpty() && languages.isEmpty()) return true
+    if (qualities.isNotEmpty() && sourceFilterQualities.none { it in qualities }) return false
+    if (languages.isNotEmpty() && sourceFilterLanguages.none { it in languages }) return false
+    return true
+}
+
+data class StreamSourceFilterState(
+    val qualities: Set<String> = emptySet(),
+    val languages: Set<String> = emptySet(),
+) {
+    val isEmpty: Boolean
+        get() = qualities.isEmpty() && languages.isEmpty()
+}
+
+/**
+ * Process-wide holder for the persisted source filter preference. Loaded from
+ * platform storage on first touch, saved on every change, and used to seed the
+ * stream lists so the preferred quality/language selection is active immediately.
+ */
+object StreamSourceFilterPrefs {
+    private val _state = MutableStateFlow(loadPersistedState())
+    val state: StateFlow<StreamSourceFilterState> = _state.asStateFlow()
+
+    private fun loadPersistedState(): StreamSourceFilterState {
+        val payload = runCatching { StreamSourceFilterStorage.loadPayload() }.getOrNull().orEmpty()
+        var qualities: Set<String> = emptySet()
+        var languages: Set<String> = emptySet()
+        payload.split('|').forEach { segment ->
+            val separator = segment.indexOf('=')
+            if (separator <= 0) return@forEach
+            val values = segment.substring(separator + 1)
+                .split(',')
+                .map { it.trim() }
+                .filter { it.isNotEmpty() }
+                .toSet()
+            when (segment.substring(0, separator).trim()) {
+                "q" -> qualities = values
+                "l" -> languages = values
+            }
+        }
+        return StreamSourceFilterState(qualities = qualities, languages = languages)
+    }
+
+    fun updateQualities(labels: Set<String>) {
+        val normalized = labels.mapNotNull { label -> StreamQualityFilter.fromLabel(label)?.label }.toSet()
+        _state.update { it.copy(qualities = normalized) }
+        persist()
+    }
+
+    fun updateLanguages(languages: Set<String>) {
+        _state.update {
+            it.copy(languages = languages.map { value -> value.trim() }.filter { value -> value.isNotEmpty() }.toSet())
+        }
+        persist()
+    }
+
+    fun clear() {
+        _state.value = StreamSourceFilterState()
+        persist()
+    }
+
+    fun selectedQualities(): Set<StreamQualityFilter> =
+        _state.value.qualities.mapNotNull { StreamQualityFilter.fromLabel(it) }.toSet()
+
+    private fun persist() {
+        val current = _state.value
+        val payload = "q=${current.qualities.joinToString(",")}|l=${current.languages.joinToString(",")}"
+        runCatching { StreamSourceFilterStorage.savePayload(payload) }
+    }
+}
+
+internal data class StreamSourceFilterAvailability(
+    val qualities: List<StreamQualityFilter>,
+    val languages: List<String>,
+) {
+    val isEmpty: Boolean
+        get() = qualities.isEmpty() && languages.isEmpty()
+}
+
+internal fun List<AddonStreamGroup>.deriveStreamSourceFilterAvailability(): StreamSourceFilterAvailability {
+    val streams = flatMap { it.streams }
+    if (streams.isEmpty()) return StreamSourceFilterAvailability(emptyList(), emptyList())
+    val qualities = StreamQualityFilter.DISPLAY_ORDER.filter { quality ->
+        streams.any { quality in it.sourceFilterQualities }
+    }
+    val counts = LinkedHashMap<String, Int>()
+    streams.forEach { stream ->
+        stream.sourceFilterLanguages.forEach { language ->
+            counts[language] = (counts[language] ?: 0) + 1
+        }
+    }
+    val languages = counts.entries.sortedByDescending { it.value }.map { it.key }
+    return StreamSourceFilterAvailability(qualities, languages)
+}
+
+/**
+ * Nuvio-styled multi-select filter row: quality chips followed by the languages
+ * present in the current list (most frequent first). Every chip is a pill that
+ * mirrors the app's existing buttons: accent fill when selected, muted surface
+ * with a subtle outline when not. Selecting multiple chips is allowed and the
+ * whole stream list is filtered by the result.
+ */
+@Composable
+internal fun StreamQualityLanguageFilterRow(
+    groups: List<AddonStreamGroup>,
+    selectedQualities: Set<StreamQualityFilter>,
+    selectedLanguages: Set<String>,
+    onQualityToggled: (StreamQualityFilter) -> Unit,
+    onLanguageToggled: (String) -> Unit,
+    onClearFilters: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val availability = remember(groups) { groups.deriveStreamSourceFilterAvailability() }
+    if (availability.isEmpty) return
+    val hasSelection = selectedQualities.isNotEmpty() || selectedLanguages.isNotEmpty()
+    LazyRow(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s8),
+        contentPadding = PaddingValues(horizontal = NuvioTokens.Space.s2),
+    ) {
+        items(availability.qualities) { quality ->
+            NuvioFilterChip(
+                label = quality.label,
+                selected = quality in selectedQualities,
+                onClick = { onQualityToggled(quality) },
+            )
+        }
+        if (hasSelection) {
+            item {
+                NuvioFilterChip(
+                    label = "Reset",
+                    selected = false,
+                    outlined = true,
+                    onClick = onClearFilters,
+                )
+            }
+        }
+        if (availability.qualities.isNotEmpty() && availability.languages.isNotEmpty()) {
+            item {
+                Box(
+                    modifier = Modifier
+                        .height(32.dp)
+                        .padding(horizontal = NuvioTokens.Space.s2),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Box(
+                        modifier = Modifier
+                            .size(3.dp)
+                            .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+                            .background(MaterialTheme.nuvio.colors.textDisabled),
+                    )
+                }
+            }
+        }
+        items(availability.languages) { language ->
+            NuvioFilterChip(
+                label = language,
+                selected = selectedLanguages.any { it.equals(language, ignoreCase = true) },
+                onClick = { onLanguageToggled(language) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun NuvioFilterChip(
+    label: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+    outlined: Boolean = false,
+) {
+    val tokens = MaterialTheme.nuvio.colors
+    val interactionSource = remember { MutableInteractionSource() }
+    val isPressed by interactionSource.collectIsPressedAsState()
+    val scale by animateFloatAsState(
+        targetValue = if (isPressed) 0.96f else 1f,
+        animationSpec = tween(durationMillis = 140),
+        label = "source_filter_chip_scale",
+    )
+    val containerColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.accent
+            outlined -> tokens.surfaceElevated
+            else -> tokens.surfaceElevated.copy(alpha = 0.65f)
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_container",
+    )
+    val contentColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.onAccent
+            outlined -> tokens.textSecondary
+            else -> tokens.textMuted
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_content",
+    )
+    val borderColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.borderSelected
+            outlined -> tokens.borderStrong
+            else -> tokens.borderDefault
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_border",
+    )
+    Box(
+        modifier = Modifier
+            .graphicsLayer {
+                scaleX = scale
+                scaleY = scale
+            }
+            .height(32.dp)
+            .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+            .background(containerColor)
+            .border(1.dp, borderColor, RoundedCornerShape(NuvioTokens.Radius.full))
+            .clickable(
+                interactionSource = interactionSource,
+                indication = null,
+                onClick = onClick,
+            )
+            .padding(horizontal = NuvioTokens.Space.s14),
+        contentAlignment = Alignment.Center,
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s6),
+        ) {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelMedium.copy(
+                    fontSize = 13.sp,
+                    fontWeight = if (selected) FontWeight.Bold else FontWeight.SemiBold,
+                    letterSpacing = 0.1.sp,
+                ),
+                color = contentColor,
+                maxLines = 1,
+            )
+        }
+    }
+}
