+package com.nuvio.app.features.streams
+
+import co.touchlab.kermit.Logger
+import com.nuvio.app.core.ui.NuvioToastController
+import com.nuvio.app.features.addons.httpRequestRaw
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlin.time.TimeSource
+
+/**
+ * Health of a source host as measured by the background sweep. The sweep runs
+ * once per calendar day (see [SourceHealthRepository.bootstrap]) and again for
+ * any host the user runs into that has not been measured yet today.
+ */
+enum class SourceHealthStatus {
+    /** Queued for the current sweep. */
+    UNKNOWN,
+
+    /** Currently being probed. */
+    CHECKING,
+
+    /** Reachable: the server answered the probe. */
+    ONLINE,
+
+    /** Unreachable, timed out, or answered with an error status. */
+    OFFLINE,
+
+    /** Streams that cannot be probed over HTTP (torrents, magnets, debrid). */
+    UNPROBEABLE,
+}
+
+data class SourceHealthEntry(
+    val status: SourceHealthStatus = SourceHealthStatus.UNKNOWN,
+    val latencyMs: Long? = null,
+)
+
+data class SourceHealthSnapshot(
+    val day: String = "",
+    val hosts: Map<String, SourceHealthEntry> = emptyMap(),
+    val sweeping: Boolean = false,
+    val completed: Int = 0,
+    val total: Int = 0,
+) {
+    val isRunning: Boolean
+        get() = sweeping && completed < total
+
+    val progress: Float
+        get() = if (total <= 0) 0f else (completed.toFloat() / total.toFloat()).coerceIn(0f, 1f)
+
+    val onlineCount: Int
+        get() = hosts.values.count { it.status == SourceHealthStatus.ONLINE }
+
+    fun entryFor(host: String?): SourceHealthEntry {
+        if (host == null) return SourceHealthEntry(status = SourceHealthStatus.UNPROBEABLE)
+        return hosts[host] ?: SourceHealthEntry(status = SourceHealthStatus.UNKNOWN)
+    }
+}
+
+/** True when [stream] may be listed: online, still being tested, or not probe-able. */
+fun SourceHealthSnapshot.isStreamVisible(stream: StreamItem): Boolean {
+    val host = stream.sourceHealthHost() ?: return true
+    return entryFor(host).status != SourceHealthStatus.OFFLINE
+}
+
+/** True while [stream] is queued or actively being probed. */
+fun SourceHealthSnapshot.isStreamTesting(stream: StreamItem): Boolean {
+    val host = stream.sourceHealthHost() ?: return false
+    return when (entryFor(host).status) {
+        SourceHealthStatus.CHECKING, SourceHealthStatus.UNKNOWN -> true
+        else -> false
+    }
+}
+
+/**
+ * Extracts the probe-able host of a stream. Returns null when the stream is not
+ * an HTTP asset (magnet/torrent/debrid/YouTube) so callers can treat it as
+ * [SourceHealthStatus.UNPROBEABLE] instead of hiding it.
+ */
+fun StreamItem.sourceHealthHost(): String? {
+    val candidate = playableDirectUrl ?: return null
+    val schemeEnd = candidate.indexOf("://")
+    if (schemeEnd <= 0) return null
+    val scheme = candidate.substring(0, schemeEnd).lowercase()
+    if (scheme != "http" && scheme != "https") return null
+    val afterScheme = candidate.substring(schemeEnd + 3)
+    val authorityEnd = afterScheme.indexOfFirst { it == '/' || it == '?' || it == '#' }
+    val authority = if (authorityEnd >= 0) afterScheme.substring(0, authorityEnd) else afterScheme
+    val host = authority.substringAfter('@').substringBefore(':').trim().lowercase()
+    return host.takeIf { it.isNotEmpty() }
+}
+
+/**
+ * Process-wide daily source health sweep.
+ *
+ * - [bootstrap] runs on app start: restores today's results, or starts a
+ *   background sweep over every host seen so far when the day rolled over.
+ *   Nothing is scheduled on the main thread and the UI stays responsive.
+ * - [registerStreams] runs when a source list is shown: hosts without a result
+ *   for today are queued, known hosts reuse their cached verdict.
+ * - Only [SourceHealthStatus.OFFLINE] sources are hidden. Queued sources stay
+ *   visible with a testing state so servers appear progressively as they pass.
+ * - A Nuvio-styled toast is shown once per day when the launch sweep finishes.
+ */
+object SourceHealthRepository {
+    private val log = Logger.withTag("SourceHealth")
+    private const val probeTimeoutMs = 6_000L
+    private const val maxConcurrentProbes = 6
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val probeSemaphore = Semaphore(maxConcurrentProbes)
+    private val bookkeeping = Mutex()
+    private val launchedHosts = mutableSetOf<String>()
+    private val sampleUrls = MutableStateFlow<Map<String, String>>(emptyMap())
+
+    private val _state = MutableStateFlow(SourceHealthSnapshot())
+    val state: StateFlow<SourceHealthSnapshot> = _state.asStateFlow()
+
+    private var bootstrapped = false
+    private var dailySweepActive = false
+    private var lastToastedDay: String? = null
+    private var toastJob: Job? = null
+
+    fun bootstrap() {
+        if (bootstrapped) return
+        bootstrapped = true
+
+        val today = CurrentDateProvider.todayIsoDate()
+        val restored = parsePersisted(runCatching { SourceHealthStorage.loadPayload() }.getOrNull())
+
+        if (restored.day == today) {
+            _state.value = SourceHealthSnapshot(
+                day = today,
+                hosts = restored.hosts,
+                sweeping = false,
+                completed = restored.hosts.size,
+                total = restored.hosts.size,
+            )
+            sampleUrls.value = restored.sampleUrls
+            log.d { "Restored ${restored.hosts.size} source health results for $today" }
+            return
+        }
+
+        if (restored.hosts.isEmpty()) {
+            _state.value = SourceHealthSnapshot(day = today)
+            return
+        }
+
+        // New calendar day: drop yesterday's verdicts and re-test every known host.
+        dailySweepActive = true
+        val pending = restored.hosts.keys.map { host ->
+            host to SourceHealthEntry(status = SourceHealthStatus.UNKNOWN)
+        }.toMap()
+        sampleUrls.value = restored.sampleUrls
+        _state.value = SourceHealthSnapshot(
+            day = today,
+            hosts = pending,
+            sweeping = true,
+            completed = 0,
+            total = pending.size,
+        )
+        log.d { "Starting daily source sweep for ${pending.size} hosts on $today" }
+        pending.keys.forEach { host -> enqueue(host) }
+    }
+
+    /** Queues probes for any host in [streams] that has no result for today. */
+    fun registerStreams(streams: List<StreamItem>) {
+        if (streams.isEmpty()) return
+        val today = CurrentDateProvider.todayIsoDate()
+        val toProbe = mutableListOf<String>()
+
+        _state.update { snapshot ->
+            val base = if (snapshot.day == today) snapshot else SourceHealthSnapshot(day = today)
+            val hosts = base.hosts.toMutableMap()
+            streams.forEach { stream ->
+                val host = stream.sourceHealthHost() ?: return@forEach
+                val sample = stream.playableDirectUrl ?: return@forEach
+                val previousSample = sampleUrls.value[host]
+                val sampleChanged = previousSample != null && previousSample != sample
+                sampleUrls.update { it + (host to sample) }
+                val existing = hosts[host]
+                val needsProbe = existing == null ||
+                    existing.status == SourceHealthStatus.UNKNOWN ||
+                    // A fresh list can hand us a new signed URL for a host we
+                    // marked offline earlier today: give it one more chance.
+                    (existing.status == SourceHealthStatus.OFFLINE && sampleChanged)
+                if (needsProbe) {
+                    hosts[host] = SourceHealthEntry(status = SourceHealthStatus.CHECKING)
+                    toProbe += host
+                }
+            }
+            base.copy(
+                hosts = hosts,
+                sweeping = base.sweeping || toProbe.isNotEmpty(),
+                total = if (base.total == 0) hosts.size else maxOf(base.total, hosts.size),
+            )
+        }
+
+        toProbe.forEach { host -> enqueue(host) }
+    }
+
+    private fun enqueue(host: String) {
+        scope.launch {
+            val claimed = bookkeeping.withLock {
+                if (host in launchedHosts) false else {
+                    launchedHosts += host
+                    true
+                }
+            }
+            if (!claimed) return@launch
+            // A new probe landed before the "testing done" toast fired: hold it
+            // back so the popup only appears once the visible list is settled.
+            toastJob?.cancel()
+
+            probeSemaphore.withPermit {
+                val sample = sampleUrls.value[host]
+                val entry = if (sample.isNullOrBlank()) {
+                    SourceHealthEntry(status = SourceHealthStatus.UNPROBEABLE)
+                } else {
+                    probe(sample)
+                }
+                _state.update { snapshot ->
+                    snapshot.copy(
+                        hosts = snapshot.hosts + (host to entry),
+                        completed = snapshot.completed + 1,
+                    )
+                }
+                bookkeeping.withLock { launchedHosts -= host }
+                completeIfFinished()
+            }
+        }
+    }
+
+    private fun completeIfFinished() {
+        val snapshot = _state.value
+        if (!snapshot.sweeping) return
+        val stillRunning = snapshot.hosts.values.any {
+            it.status == SourceHealthStatus.CHECKING || it.status == SourceHealthStatus.UNKNOWN
+        }
+        if (stillRunning) return
+
+        val finishedDailySweep = dailySweepActive
+        dailySweepActive = false
+        _state.update {
+            it.copy(sweeping = false, completed = it.total, total = maxOf(it.total, it.hosts.size))
+        }
+        persist()
+        // One "testing done" toast per calendar day, whichever sweep finished
+        // first (the launch sweep, or the first source list of the day). It is
+        // debounced so addon groups that arrive a moment later stay included.
+        if (lastToastedDay != snapshot.day) {
+            toastJob?.cancel()
+            toastJob = scope.launch {
+                delay(3_000L)
+                val current = _state.value
+                if (current.isRunning) return@launch
+                if (lastToastedDay == current.day) return@launch
+                lastToastedDay = current.day
+                NuvioToastController.show(SourceHealthTexts.testingDone, durationMillis = 2_400L)
+            }
+        }
+        if (finishedDailySweep) {
+            log.d { "Daily source sweep finished for ${snapshot.day}" }
+        }
+    }
+
+    /** True when the source may be listed (online, untested or not probe-able). */
+    fun isSourcePassing(stream: StreamItem): Boolean {
+        val host = stream.sourceHealthHost() ?: return true
+        return _state.value.entryFor(host).status != SourceHealthStatus.OFFLINE
+    }
+
+    /** True while this source is queued or in flight. */
+    fun isSourceTesting(stream: StreamItem): Boolean {
+        val host = stream.sourceHealthHost() ?: return false
+        return when (_state.value.entryFor(host).status) {
+            SourceHealthStatus.CHECKING, SourceHealthStatus.UNKNOWN -> true
+            else -> false
+        }
+    }
+
+    fun latencyFor(host: String?): Long? = host?.let { _state.value.entryFor(it).latencyMs }
+
+    private suspend fun probe(url: String): SourceHealthEntry {
+        val mark = TimeSource.Monotonic.markNow()
+        val response = withTimeoutOrNull(probeTimeoutMs) {
+            runCatching {
+                httpRequestRaw(
+                    method = "GET",
+                    url = url,
+                    headers = mapOf("Range" to "bytes=0-0"),
+                    body = "",
+                    maxResponseBodyBytes = 2_048,
+                )
+            }.getOrNull()
+        }
+        val elapsed = mark.elapsedNow().inWholeMilliseconds
+        return when {
+            response == null -> SourceHealthEntry(status = SourceHealthStatus.OFFLINE)
+            response.status in 200..399 -> SourceHealthEntry(
+                status = SourceHealthStatus.ONLINE,
+                latencyMs = elapsed,
+            )
+            else -> SourceHealthEntry(status = SourceHealthStatus.OFFLINE)
+        }
+    }
+
+    private fun persist() {
+        val snapshot = _state.value
+        if (snapshot.hosts.isEmpty()) return
+        val samples = sampleUrls.value
+        val payload = buildString {
+            append("d=")
+            append(snapshot.day)
+            append('\n')
+            snapshot.hosts.forEach { (host, entry) ->
+                append(host)
+                append('\t')
+                append(entry.status.name)
+                append('\t')
+                append(entry.latencyMs?.toString().orEmpty())
+                append('\t')
+                append(samples[host].orEmpty())
+                append('\n')
+            }
+        }
+        runCatching { SourceHealthStorage.savePayload(payload) }
+    }
+
+    private data class PersistedHealth(
+        val day: String,
+        val hosts: Map<String, SourceHealthEntry>,
+        val sampleUrls: Map<String, String>,
+    )
+
+    private fun parsePersisted(payload: String?): PersistedHealth {
+        if (payload.isNullOrBlank()) return PersistedHealth("", emptyMap(), emptyMap())
+        var day = ""
+        val hosts = mutableMapOf<String, SourceHealthEntry>()
+        val samples = mutableMapOf<String, String>()
+        payload.lineSequence().forEach { line ->
+            if (line.isBlank()) return@forEach
+            if (line.startsWith("d=")) {
+                day = line.removePrefix("d=").trim()
+                return@forEach
+            }
+            val parts = line.split('\t')
+            if (parts.size < 2) return@forEach
+            val host = parts[0].trim()
+            if (host.isEmpty()) return@forEach
+            val status = runCatching { SourceHealthStatus.valueOf(parts[1].trim()) }
+                .getOrElse { SourceHealthStatus.UNKNOWN }
+            val latency = parts.getOrNull(2)?.trim()?.takeIf { it.isNotEmpty() }?.toLongOrNull()
+            val sample = parts.getOrNull(3)?.trim()?.takeIf { it.isNotEmpty() }
+            hosts[host] = SourceHealthEntry(status = status, latencyMs = latency)
+            if (sample != null) samples[host] = sample
+        }
+        return PersistedHealth(day = day, hosts = hosts, sampleUrls = samples)
+    }
+}
