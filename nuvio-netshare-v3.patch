+data class StreamSourceFilterState(
+    val qualities: Set<String> = emptySet(),
+    val languages: Set<String> = emptySet(),
+) {
+    val isEmpty: Boolean
+        get() = qualities.isEmpty() && languages.isEmpty()
+}
+
+/**
+ * Process-wide holder for the persisted source filter preference. Loaded from
+ * platform storage on first touch, saved on every change, and used to seed the
+ * stream lists so the preferred quality/language selection is active immediately.
+ */
+object StreamSourceFilterPrefs {
+    private val _state = MutableStateFlow(loadPersistedState())
+    val state: StateFlow<StreamSourceFilterState> = _state.asStateFlow()
+
+    private fun loadPersistedState(): StreamSourceFilterState {
+        val payload = runCatching { StreamSourceFilterStorage.loadPayload() }.getOrNull().orEmpty()
+        var qualities: Set<String> = emptySet()
+        var languages: Set<String> = emptySet()
+        payload.split('|').forEach { segment ->
+            val separator = segment.indexOf('=')
+            if (separator <= 0) return@forEach
+            val values = segment.substring(separator + 1)
+                .split(',')
+                .map { it.trim() }
+                .filter { it.isNotEmpty() }
+                .toSet()
+            when (segment.substring(0, separator).trim()) {
+                "q" -> qualities = values
+                "l" -> languages = values
+            }
+        }
+        return StreamSourceFilterState(qualities = qualities, languages = languages)
+    }
+
+    fun updateQualities(labels: Set<String>) {
+        val normalized = labels.mapNotNull { label -> StreamQualityFilter.fromLabel(label)?.label }.toSet()
+        _state.update { it.copy(qualities = normalized) }
+        persist()
+    }
+
+    fun updateLanguages(languages: Set<String>) {
+        _state.update {
+            it.copy(languages = languages.map { value -> value.trim() }.filter { value -> value.isNotEmpty() }.toSet())
+        }
+        persist()
+    }
+
+    fun clear() {
+        _state.value = StreamSourceFilterState()
+        persist()
+    }
+
+    fun selectedQualities(): Set<StreamQualityFilter> =
+        _state.value.qualities.mapNotNull { StreamQualityFilter.fromLabel(it) }.toSet()
+
+    private fun persist() {
+        val current = _state.value
+        val payload = "q=${current.qualities.joinToString(",")}|l=${current.languages.joinToString(",")}"
+        runCatching { StreamSourceFilterStorage.savePayload(payload) }
+    }
+}
