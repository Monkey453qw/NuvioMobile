+        // launched window, which leaves the SurfaceView letterbox strips
+        // translucent until the window state is rebuilt (entering and leaving
+        // a floating window cures it). Re-issue the bar hide and the insets
+        // dispatch shortly after the player opens so the same state heals
+        // itself without any user action.
+        val healKick = Runnable {
+            val kickController = WindowCompat.getInsetsController(window, window.decorView)
+            kickController.hide(WindowInsetsCompat.Type.systemBars())
+            kickController.systemBarsBehavior =
+                WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+            window.decorView.requestApplyInsets()
+        }
+        window.decorView.postDelayed(healKick, 450L)
+        window.decorView.postDelayed(healKick, 1500L)
+
         onDispose {
+            window.decorView.removeCallbacks(healKick)
             controller.show(WindowInsetsCompat.Type.systemBars())
             controller.systemBarsBehavior = previousBehavior
+            window.decorView.background = previousDecorBackground
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                window.attributes = window.attributes.apply {
+                    layoutInDisplayCutoutMode = previousCutoutMode
+                }
+            }
