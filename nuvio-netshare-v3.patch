+/**
+ * Nuvio-styled multi-select filter row: quality chips followed by the languages
+ * present in the current list (most frequent first). Every chip is a pill that
+ * mirrors the app's existing buttons: accent fill when selected, muted surface
+ * with a subtle outline when not. Selecting multiple chips is allowed and the
+ * whole stream list is filtered by the result.
+ */
+@Composable
+internal fun StreamQualityLanguageFilterRow(
+    groups: List<AddonStreamGroup>,
+    selectedQualities: Set<StreamQualityFilter>,
+    selectedLanguages: Set<String>,
+    onQualityToggled: (StreamQualityFilter) -> Unit,
+    onLanguageToggled: (String) -> Unit,
+    onClearFilters: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val availability = remember(groups) { groups.deriveStreamSourceFilterAvailability() }
+    if (availability.isEmpty) return
+    val hasSelection = selectedQualities.isNotEmpty() || selectedLanguages.isNotEmpty()
+    LazyRow(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s8),
+        contentPadding = PaddingValues(horizontal = NuvioTokens.Space.s2),
+    ) {
+        items(availability.qualities) { quality ->
+            NuvioFilterChip(
+                label = quality.label,
+                selected = quality in selectedQualities,
+                onClick = { onQualityToggled(quality) },
+            )
+        }
+        if (hasSelection) {
+            item {
+                NuvioFilterChip(
+                    label = "Reset",
+                    selected = false,
+                    outlined = true,
+                    onClick = onClearFilters,
+                )
+            }
+        }
+        if (availability.qualities.isNotEmpty() && availability.languages.isNotEmpty()) {
+            item {
+                Box(
+                    modifier = Modifier
+                        .height(32.dp)
+                        .padding(horizontal = NuvioTokens.Space.s2),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Box(
+                        modifier = Modifier
+                            .size(3.dp)
+                            .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+                            .background(MaterialTheme.nuvio.colors.textDisabled),
+                    )
+                }
+            }
+        }
+        items(availability.languages) { language ->
+            NuvioFilterChip(
+                label = language,
+                selected = selectedLanguages.any { it.equals(language, ignoreCase = true) },
+                onClick = { onLanguageToggled(language) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun NuvioFilterChip(
+    label: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+    outlined: Boolean = false,
+) {
+    val tokens = MaterialTheme.nuvio.colors
+    val interactionSource = remember { MutableInteractionSource() }
+    val isPressed by interactionSource.collectIsPressedAsState()
+    val scale by animateFloatAsState(
+        targetValue = if (isPressed) 0.96f else 1f,
+        animationSpec = tween(durationMillis = 140),
+        label = "source_filter_chip_scale",
+    )
+    val containerColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.accent
+            outlined -> tokens.surfaceElevated
+            else -> tokens.surfaceElevated.copy(alpha = 0.65f)
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_container",
+    )
+    val contentColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.onAccent
+            outlined -> tokens.textSecondary
+            else -> tokens.textMuted
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_content",
+    )
+    val borderColor by animateColorAsState(
+        targetValue = when {
+            selected -> tokens.borderSelected
+            outlined -> tokens.borderStrong
+            else -> tokens.borderDefault
+        },
+        animationSpec = tween(durationMillis = 180),
+        label = "source_filter_chip_border",
+    )
+    Box(
+        modifier = Modifier
+            .graphicsLayer {
+                scaleX = scale
+                scaleY = scale
+            }
+            .height(32.dp)
+            .clip(RoundedCornerShape(NuvioTokens.Radius.full))
+            .background(containerColor)
+            .border(1.dp, borderColor, RoundedCornerShape(NuvioTokens.Radius.full))
+            .clickable(
+                interactionSource = interactionSource,
+                indication = null,
+                onClick = onClick,
+            )
+            .padding(horizontal = NuvioTokens.Space.s14),
+        contentAlignment = Alignment.Center,
+    ) {
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(NuvioTokens.Space.s6),
+        ) {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelMedium.copy(
+                    fontSize = 13.sp,
+                    fontWeight = if (selected) FontWeight.Bold else FontWeight.SemiBold,
+                    letterSpacing = 0.1.sp,
+                ),
+                color = contentColor,
+                maxLines = 1,
+            )
+        }
+    }
+}
+
+/**
+ * Balanced ranking used by the "Best available" strip: good quality with a
+ * quick streaming start. Latency dominates only when the gap is large, so a
+ * healthy 1080p source still beats a slow 4K one.
+ */
+internal fun StreamItem.bestSourceScore(latencyMs: Long?): Float {
+    val bestQuality = sourceFilterQualities.maxOfOrNull { it.qualityWeight } ?: 0.5f
+    val latencyScore = latencyMs?.let { latency ->
+        1f - (latency.coerceIn(0L, 4_000L).toFloat() / 4_000f)
+    } ?: 0.55f
+    return (bestQuality * 0.6f) + (latencyScore * 0.4f)
+}
