+/**
+ * Quality buckets used by the source filter row. Buckets are derived from the
+ * stream name/title/badges, so they work for every addon and debrid provider
+ * without extra metadata support.
+ */
+enum class StreamQualityFilter(val label: String) {
+    ULTRA("4K"),
+    FHD("1080p"),
+    HD("720p"),
+    SD("SD");
+
+    companion object {
+        val DISPLAY_ORDER: List<StreamQualityFilter> = listOf(ULTRA, FHD, HD, SD)
+
+        fun fromLabel(label: String?): StreamQualityFilter? =
+            label?.trim()?.takeIf { it.isNotEmpty() }
+                ?.let { candidate -> entries.firstOrNull { it.label.equals(candidate, ignoreCase = true) } }
+    }
+}
