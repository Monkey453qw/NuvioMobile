+data class StreamSourceFilterState(
+    val quality: String? = null,
+    val language: String? = null,
+)
+
+/**
+ * Process-wide holder for the persisted source filter preference. Loaded from
+ * platform storage on first touch, saved on every change, and used to seed the
+ * stream lists so the preferred quality/language is active immediately.
+ */
+object StreamSourceFilterPrefs {
+    private val _state = MutableStateFlow(loadPersistedState())
+    val state: StateFlow<StreamSourceFilterState> = _state.asStateFlow()
+
+    private fun loadPersistedState(): StreamSourceFilterState {
+        val payload = runCatching { StreamSourceFilterStorage.loadPayload() }.getOrNull().orEmpty()
+        var quality: String? = null
+        var language: String? = null
+        payload.split('|').forEach { segment ->
+            val separator = segment.indexOf('=')
+            if (separator <= 0) return@forEach
+            val value = segment.substring(separator + 1).trim().takeIf { it.isNotEmpty() } ?: return@forEach
+            when (segment.substring(0, separator).trim()) {
+                "q" -> quality = value
+                "l" -> language = value
+            }
+        }
+        return StreamSourceFilterState(quality = quality, language = language)
+    }
+
+    fun updateQuality(label: String?) {
+        _state.update { it.copy(quality = label?.trim()?.takeIf { value -> value.isNotEmpty() }) }
+        persist()
+    }
+
+    fun updateLanguage(language: String?) {
+        _state.update { it.copy(language = language?.trim()?.takeIf { value -> value.isNotEmpty() }) }
+        persist()
+    }
+
+    private fun persist() {
+        val current = _state.value
+        val payload = "q=${current.quality.orEmpty()}|l=${current.language.orEmpty()}"
+        runCatching { StreamSourceFilterStorage.savePayload(payload) }
+    }
+}
+
+internal data class StreamSourceFilterAvailability(
+    val qualities: List<StreamQualityFilter>,
+    val languages: List<String>,
+)
+
+internal fun List<AddonStreamGroup>.deriveStreamSourceFilterAvailability(): StreamSourceFilterAvailability {
+    val streams = flatMap { it.streams }
+    if (streams.isEmpty()) return StreamSourceFilterAvailability(emptyList(), emptyList())
+    val qualities = StreamQualityFilter.DISPLAY_ORDER.filter { quality ->
+        streams.any { quality in it.sourceFilterQualities }
+    }
+    val counts = LinkedHashMap<String, Int>()
+    streams.forEach { stream ->
+        stream.sourceFilterLanguages.forEach { language ->
+            counts[language] = (counts[language] ?: 0) + 1
+        }
+    }
+    val languages = counts.entries.sortedByDescending { it.value }.map { it.key }
+    return StreamSourceFilterAvailability(qualities, languages)
+}
+
+/**
+ * Compact one-tap filter row: quality chips + a divider + the languages that
+ * are actually present in the current stream list (most frequent first).
+ * Tapping a selected chip clears that filter. Shown only when there is
+ * something to filter on, so it never adds visual noise.
+ */
+@Composable
+internal fun StreamQualityLanguageFilterRow(
+    groups: List<AddonStreamGroup>,
+    selectedQuality: StreamQualityFilter?,
+    selectedLanguage: String?,
+    onQualitySelected: (StreamQualityFilter?) -> Unit,
+    onLanguageSelected: (String?) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val availability = remember(groups) { groups.deriveStreamSourceFilterAvailability() }
+    if (availability.qualities.isEmpty() && availability.languages.isEmpty()) return
+    LazyRow(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+        contentPadding = PaddingValues(horizontal = 2.dp),
+    ) {
+        items(availability.qualities) { quality ->
+            FilterChip(
+                selected = selectedQuality == quality,
+                onClick = { onQualitySelected(if (selectedQuality == quality) null else quality) },
+                label = {
+                    Text(
+                        text = quality.label,
+                        style = MaterialTheme.typography.labelMedium,
+                        maxLines = 1,
+                    )
+                },
+            )
+        }
+        if (availability.qualities.isNotEmpty() && availability.languages.isNotEmpty()) {
+            item {
+                Text(
+                    text = "•",
+                    style = MaterialTheme.typography.labelMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.4f),
+                    modifier = Modifier.padding(horizontal = 2.dp),
+                )
+            }
+        }
+        items(availability.languages.take(8)) { language ->
+            FilterChip(
+                selected = selectedLanguage.equals(language, ignoreCase = true),
+                onClick = {
+                    onLanguageSelected(
+                        if (selectedLanguage.equals(language, ignoreCase = true)) null else language,
+                    )
+                },
+                label = {
+                    Text(
+                        text = language,
+                        style = MaterialTheme.typography.labelMedium,
+                        maxLines = 1,
+                    )
+                },
+            )
+        }
+    }
+}
